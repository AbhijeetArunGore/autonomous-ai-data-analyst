# AI Data Analyst OS - Environment Configuration

# Server Configuration
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database Configuration (PostgreSQL in production, SQLite in local dev)
DATABASE_URL=sqlite:///./ai_data_analyst.db

# Storage Directory
STORAGE_DIR=./storage_data

# LLM Provider Configuration (Supports OpenAI, Gemini, Anthropic, Mock)
LLM_PROVIDER=mock  # Options: openai, gemini, anthropic, mock
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Cost Optimization Tiers
DEFAULT_COST_MODE=balanced # Options: economy, balanced, quality

# TTS / Audio Storytelling Provider (Optional)
TTS_PROVIDER=mock # Options: openai, edge_tts, mock

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
